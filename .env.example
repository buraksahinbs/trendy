DATABASE_URL=postgres://trendy:trendy@localhost:5432/trendy
REDIS_URL=redis://localhost:6379
# 32 byte, base64. Üretmek için: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=
# Trendyol User-Agent'taki firma adı (alfanümerik, ≤30). Kendi hesabı için: SelfIntegration
TRENDYOL_INTEGRATOR_NAME=SelfIntegration
# Anahtar rotasyonu: güncel anahtarın sürümü ve eski anahtarlar ("1:base64,2:base64")
SECRETS_ENCRYPTION_KEY_VERSION=1
SECRETS_ENCRYPTION_PREVIOUS_KEYS=
NODE_ENV=development
LOG_LEVEL=info
