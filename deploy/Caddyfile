# Otomatik HTTPS (Let's Encrypt). DOMAIN'in DNS A kaydı bu sunucuyu göstermeli.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Güvenlik başlıkları
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# API: tarayıcı /api/... ister, API'ye önek olmadan iletilir.
	handle_path /api/* {
		reverse_proxy api:3000
	}

	# Trendyol sipariş webhook'u (URL'de "trendyol" geçmez: /hooks/o/<token>)
	handle /hooks/* {
		reverse_proxy api:3000
	}

	# Sağlık kontrolü dışarıdan izleme için (yalnızca sonuç, ayrıntı yok)
	handle /health/ready {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:3200
	}
}
